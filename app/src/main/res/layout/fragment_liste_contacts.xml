<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/ContactPage">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to My Contact"
        android:textColor="@color/contact_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Gardez vos proches à portée de main"
        android:textColor="@color/contact_hint"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Rechercher un contact..."
        android:contentDescription="Rechercher par nom, prénom ou téléphone"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:maxLines="1"
        style="@style/ContactInput" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="Quick Access"
        android:textColor="@color/contact_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="All Contacts"
                style="@style/ContactPrimaryButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Favorites"
                style="@style/ContactPrimaryButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterFamily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="My Family"
                style="@style/ContactPrimaryButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterDuplicates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duplicate"
                style="@style/ContactPrimaryButton" />

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/listTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All Contacts"
            android:textColor="@color/contact_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contactCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 contact"
            android:textColor="@color/contact_hint"
            android:textSize="14sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Aucun contact."
            android:textColor="@color/contact_hint"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ Ajouter un contact"
        android:visibility="gone"
        style="@style/ContactPrimaryButton" />

</LinearLayout>