<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ContactPage">
        <item name="android:background">@color/contact_background</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="ContactCard">
        <item name="android:background">@drawable/bg_contact_card</item>
    </style>

    <style name="ContactTitle">
        <item name="android:textColor">@color/contact_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ContactLabel">
        <item name="android:textColor">@color/contact_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="ContactInput">
        <item name="android:background">@drawable/bg_contact_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/contact_text</item>
        <item name="android:textColorHint">@color/contact_hint</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ContactPrimaryButton"
        parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/contact_purple</item>
        <item name="android:textColor">@color/contact_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ContactSecondaryButton"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/contact_purple</item>
        <item name="strokeColor">@color/contact_purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

</resources>