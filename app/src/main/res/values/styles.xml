<resources>
    <style name="Theme.Contacts"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">        <item name="colorPrimary">#304D67</item>
        <item name="colorPrimary">#1982C4</item>
        <item name="colorPrimaryVariant">#1982C4</item>
        <item name="colorSecondary">#1982C4</item>
        <item name="colorAccent">#1982C4</item>
        <item name="colorControlActivated">#1982C4</item>
        <item name="android:statusBarColor">#1982C4</item>
    </style>

    <style name="PageTitle">
        <item name="android:textSize">29sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#20384D</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="ContactAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_contact_soft</item>
        <item name="android:textColor">@color/contacts_accent_dark</item>
    </style>

    <style name="ContactAction.Primary">
        <item name="android:background">@drawable/bg_contact_soft</item>
        <item name="android:backgroundTint">@color/contacts_accent</item>
        <item name="android:textColor">@color/contacts_surface</item>
    </style>

    <style name="ContactAction.Danger">
        <item name="android:background">@drawable/bg_contact_card</item>
        <item name="android:textColor">@color/contacts_danger</item>
    </style>
</resources>